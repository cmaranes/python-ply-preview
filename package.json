{
  "name": "python-ply-preview",
  "displayName": "Python PLY Preview",
  "description": "Enhance your debugging experience when working with point cloud data. This extension allows you to seamlessly preview and interact with PLY files and NumPy point clouds directly within the VS Code debugger.",
  "version": "0.1.1",
  "publisher": "cmaranes",
  "engines": {
    "vscode": "^1.90.0"
  },
  "icon": "images/icon.png",
  "categories": [
    "Debuggers",
    "Data Science",
    "Visualization"
  ],
  "keywords": [
    "python",
    "ply",
    "numpy",
    "open3d",
    "3d",
    "visualization",
    "preview"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/cmaranes/python-ply-preview"
  },
  "activationEvents": [
    "onLanguage:python"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "python-ply-preview.view",
        "title": "View as Point Cloud (PLY)",
        "category": "Python PLY Preview"
      }
    ],
    "menus": {
      "debug/variables/context": [
        {
          "command": "python-ply-preview.view",
          "when": "debugType == debugpy || debugType == python",
          "group": "navigation"
        }
      ],
      "debug/watch/context": [
        {
          "command": "python-ply-preview.view",
          "when": "debugType == debugpy || debugType == python",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "python-ply-preview.view",
          "when": "inDebugMode && editorLangId == python",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "python-ply-preview.view",
          "when": "inDebugMode"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.1",
    "@types/node": "20.2.5",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^8.57.1",
    "typescript": "^5.9.3"
  },
  "extensionDependencies": [
    "tatsy.vscode-3d-preview"
  ],
  "overrides": {
    "serialize-javascript": "^7.0.7",
    "brace-expansion": "^5.0.12",
    "diff": "^8.0.3"
  }
}
