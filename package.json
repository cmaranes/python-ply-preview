{
  "name": "python-ply-preview",
  "displayName": "Python PLY Preview",
  "description": "Preview Open3D point clouds, NumPy arrays and PyTorch tensors in a 3D viewer while debugging Python, right inside VS Code.",
  "version": "0.2.0",
  "publisher": "cmaranes",
  "engines": {
    "vscode": "^1.90.0"
  },
  "icon": "images/icon.png",
  "categories": [
    "Debuggers",
    "Data Science",
    "Visualization"
  ],
  "keywords": [
    "python",
    "ply",
    "numpy",
    "open3d",
    "3d",
    "visualization",
    "preview"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/cmaranes/python-ply-preview"
  },
  "activationEvents": [
    "onLanguage:python"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "python-ply-preview.view",
        "title": "View as Point Cloud (PLY)",
        "category": "Python PLY Preview"
      }
    ],
    "menus": {
      "debug/variables/context": [
        {
          "command": "python-ply-preview.view",
          "when": "debugType == debugpy || debugType == python",
          "group": "navigation"
        }
      ],
      "debug/watch/context": [
        {
          "command": "python-ply-preview.view",
          "when": "debugType == debugpy || debugType == python",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "python-ply-preview.view",
          "when": "inDebugMode && editorLangId == python",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "python-ply-preview.view",
          "when": "inDebugMode"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "pythonPlyPreview.plyEditor",
        "displayName": "Point Cloud Viewer (Python PLY Preview)",
        "selector": [
          {
            "filenamePattern": "*.ply"
          }
        ],
        "priority": "option"
      }
    ],
    "configuration": {
      "title": "Python PLY Preview",
      "properties": {
        "pythonPlyPreview.viewer": {
          "type": "string",
          "enum": [
            "builtin",
            "default"
          ],
          "enumDescriptions": [
            "Show point clouds in the built-in viewer.",
            "Open the exported .ply file with the default editor for .ply files, for example the 3D Preview extension."
          ],
          "default": "builtin",
          "description": "Where point clouds previewed during debugging are shown."
        },
        "pythonPlyPreview.maxPoints": {
          "type": "integer",
          "minimum": 0,
          "default": 1000000,
          "markdownDescription": "Larger point clouds are randomly subsampled to this many points before export, to keep the debugger and the viewer responsive. The same points are kept every time. `0` exports every point."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && tsc -p src/webview && node esbuild.mjs",
    "watch": "tsc -watch -p ./",
    "watch:webview": "node esbuild.mjs --watch",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.1",
    "@types/node": "20.2.5",
    "@types/three": "~0.186.0",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "~0.28.2",
    "eslint": "^8.57.1",
    "three": "~0.186.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "serialize-javascript": "^7.0.7",
    "brace-expansion": "^5.0.12",
    "diff": "^8.0.3"
  }
}
